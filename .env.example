# Enterprise Document Intelligence & RAG Assistant Configuration

APP_ENV=development
LOG_LEVEL=INFO

# Storage Paths
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/app.db
FAISS_INDEX_PATH=./data/indexes/faiss.index
FAISS_METADATA_PATH=./data/indexes/faiss_meta.json
DOCUMENTS_DIR=./data/documents
EVALUATION_DIR=./data/evaluation

# Ingestion & Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Embedding & Vector Search
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_WEIGHT=0.6
KEYWORD_WEIGHT=0.4
TOP_K=10
FINAL_TOP_K=5

# Reranking
ENABLE_RERANKING=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# LLM Provider Configuration (OpenAI Compatible or Mock)
# If LLM_API_KEY is empty, system runs in offline Mock mode for testing/demo.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-3.5-turbo
LLM_TEMPERATURE=0.0
